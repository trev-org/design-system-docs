      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.600}",
        "$description": "Selected and active borders."
      },
      "success": {
        "$type": "color",
        "$value": "{color.green.600}",
        "$description": "Success field and alert borders."
      },
      "warning": {
        "$type": "color",
        "$value": "{color.amber.500}",
        "$description": "Warning alert borders."
      },
      "danger": {
        "$type": "color",
        "$value": "{color.red.600}",
        "$description": "Error field and alert borders."
      },
      "info": {
        "$type": "color",
        "$value": "{color.blue.500}",
        "$description": "Info alert borders."
      }
