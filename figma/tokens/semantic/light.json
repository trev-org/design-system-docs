{
  "color": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "{color.base.white}",
        "$description": "App background behind all surfaces."
      },
      "surface": {
        "$type": "color",
        "$value": "{color.base.white}",
        "$description": "Cards, modals, popovers and inputs."
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$description": "Low-emphasis fills: table stripes, sidebars."
